# Example environment configuration for shows_api_backend (FastAPI)
# Copy to .env and adjust values for your environment.

# REQUIRED
# PostgreSQL connection URL. Example formats:
# - postgres://user:pass@localhost:5432/shows
# - postgresql://user:pass@localhost:5432/shows
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shows

# JWT secret used to sign tokens. Use a long, random string (min 16 chars).
# Do NOT use production secrets in version control.
JWT_SECRET=please-change-this-in-production-123456

# OPTIONAL
# Runtime environment: development | production | test
ENV=development

# JWT expiry in minutes
JWT_EXPIRES_MINUTES=60

# Comma-separated list of allowed origins for CORS, or * for all (dev only)
CORS_ORIGINS=*

# Cookie settings
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Common platform-injected extras (ignored if unused by the app)
uvicorn_host=0.0.0.0
uvicorn_workers=1
node_env=development
request_timeout_ms=30000
rate_limit_window_s=60
rate_limit_max=100
port=8000

# Logging level for the application
LOG_LEVEL=INFO
