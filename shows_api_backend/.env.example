# Runtime environment
ENV=development

# Database (PostgreSQL DSN)
# Example: postgres://postgres:postgres@localhost:5432/grateful_dead
DATABASE_URL=postgres://USER:PASS@HOST:PORT/DBNAME

# Authentication
# Use a strong, random value (min 16 chars). Do not commit real secrets.
JWT_SECRET=changeme-super-secret-and-long
JWT_EXPIRES_MINUTES=60

# CORS
# Comma-separated list of origins. Use * only for local development.
# Example: http://localhost:3000,https://myapp.example.com
CORS_ORIGINS=*

# Cookies
# Use true in production with HTTPS; set false only for local HTTP development.
COOKIE_SECURE=true
# Optional cookie domain (e.g., .example.com). Leave empty to omit.
COOKIE_DOMAIN=
# lax | strict | none
COOKIE_SAMESITE=lax

# LOGGING
# LOG_LEVEL can be DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
