# Copy to .env and set values for your environment.

# PostgreSQL connection string (sync style is fine; will be converted to asyncpg internally)
# Examples:
# postgresql://user:pass@localhost:5432/gd
# postgres://user:pass@db:5432/gd
DATABASE_URL=postgresql://user:password@localhost:5432/shows

# JWT configuration
JWT_SECRET=please-change-me-to-a-strong-secret
JWT_EXPIRES_MINUTES=60

# CORS (comma-separated origins or * for all - only use * in development)
CORS_ORIGINS=http://localhost:3000

# Cookies and env
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
ENV=development
